<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stop_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_row"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/stop_time"
        style="@style/Tb.Body"
        android:layout_width="@dimen/tb_timeline_time_w"
        android:layout_height="wrap_content"
        android:text="@string/stop_time_placeholder" />

    <TextView
        android:id="@+id/stop_name"
        style="@style/Tb.CardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/tb_gap"
        android:textSize="@dimen/tb_text_field"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/stop_name_placeholder" />

    <TextView
        android:id="@+id/stop_tag"
        style="@style/Tb.Chip"
        android:layout_marginStart="@dimen/tb_gap_sm"
        android:text="@string/tag_memo_done" />
</LinearLayout>
