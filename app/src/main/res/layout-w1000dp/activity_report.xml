<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tb_bg">

    <include layout="@layout/view_topbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <include layout="@layout/view_rail" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/tb_gutter"
            android:paddingEnd="@dimen/tb_gutter"
            android:paddingTop="@dimen/tb_card_pad_v"
            android:paddingBottom="@dimen/tb_card_pad_v">

            <TextView
                android:id="@+id/report_title"
                style="@style/Tb.H1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="52sp"
                android:text="@string/report_title" />

            <LinearLayout
                style="@style/Tb.Card"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/report_key_1"
                        style="@style/Tb.Label"
                        android:layout_width="@dimen/tb_report_key_w"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/tb_text_body"
                        android:text="@string/report_key_customer" />

                    <TextView
                        android:id="@+id/report_value_1"
                        style="@style/Tb.Body.Ink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/tb_text_field"
                        android:text="@string/report_customer_tech_sample" />

                    <TextView
                        android:id="@+id/report_source_1"
                        android:visibility="gone"
                        style="@style/Tb.Label"
                        android:layout_marginStart="@dimen/tb_gap_sm"
                        android:text="@string/report_source_job" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/report_key_2"
                        style="@style/Tb.Label"
                        android:layout_width="@dimen/tb_report_key_w"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/tb_text_body"
                        android:text="@string/report_key_symptom" />

                    <TextView
                        android:id="@+id/report_value_2"
                        style="@style/Tb.Body.Ink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/tb_text_field"
                        android:text="@string/memo_demo_tech_1" />

                    <TextView
                        android:id="@+id/report_source_2"
                        android:visibility="gone"
                        style="@style/Tb.Label"
                        android:layout_marginStart="@dimen/tb_gap_sm"
                        android:text="@string/report_source_missing" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        style="@style/Tb.Label"
                        android:layout_width="@dimen/tb_report_key_w"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/tb_text_body"
                        android:text="@string/report_key_visit" />

                    <TextView
                        android:id="@+id/report_value_visit"
                        style="@style/Tb.Body.Ink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/tb_text_field"
                        android:text="@string/report_visit_sample" />

                    <TextView
                        android:id="@+id/report_source_visit"
                        android:visibility="gone"
                        style="@style/Tb.Label"
                        android:layout_marginStart="@dimen/tb_gap_sm"
                        android:text="@string/report_source_auto" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/report_key_3"
                        style="@style/Tb.Label"
                        android:layout_width="@dimen/tb_report_key_w"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/tb_text_body"
                        android:text="@string/report_key_action" />

                    <TextView
                        android:id="@+id/report_value_3"
                        style="@style/Tb.Body.Ink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/tb_text_field"
                        android:text="@string/report_blank" />

                    <TextView
                        android:id="@+id/report_source_3"
                        android:visibility="gone"
                        style="@style/Tb.Label"
                        android:layout_marginStart="@dimen/tb_gap_sm"
                        android:text="@string/report_source_missing" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/report_key_4"
                        style="@style/Tb.Label"
                        android:layout_width="@dimen/tb_report_key_w"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/tb_text_body"
                        android:text="@string/report_key_part" />

                    <TextView
                        android:id="@+id/report_value_4"
                        style="@style/Tb.Body.Ink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/tb_text_field"
                        android:text="@string/report_blank" />

                    <TextView
                        android:id="@+id/report_source_4"
                        android:visibility="gone"
                        style="@style/Tb.Label"
                        android:layout_marginStart="@dimen/tb_gap_sm"
                        android:text="@string/report_source_missing" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="20dp">

                    <TextView
                        android:id="@+id/report_key_5"
                        style="@style/Tb.Label"
                        android:layout_width="@dimen/tb_report_key_w"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/tb_text_body"
                        android:text="@string/report_key_result" />

                    <TextView
                        android:id="@+id/report_value_5"
                        style="@style/Tb.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/tb_text_field"
                        android:text="@string/report_blank" />

                    <TextView
                        android:id="@+id/report_source_5"
                        android:visibility="gone"
                        style="@style/Tb.Label"
                        android:layout_marginStart="@dimen/tb_gap_sm"
                        android:text="@string/report_source_missing" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/tb_gap">

                <TextView
                    android:id="@+id/btn_edit_memo"
                    style="@style/Tb.Button.Ghost"
                    android:layout_width="260dp"
                    android:text="@string/action_edit_memo" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_submit"
                    style="@style/Tb.Button.Primary"
                    android:layout_width="360dp"
                    android:text="@string/action_submit" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
