<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tb_bg">

    <include layout="@layout/view_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/tb_gutter"
        android:paddingEnd="@dimen/tb_gutter"
        android:paddingTop="@dimen/tb_card_pad_v"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Tb.H1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/confirm_title" />

            <TextView
                android:id="@+id/confirm_sub"
                style="@style/Tb.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="@dimen/tb_gap"
                android:text="@string/confirm_sub_sample" />

            <LinearLayout
                android:id="@+id/card_job"
                style="@style/Tb.Card"
                android:background="@drawable/bg_card">

                <TextView
                    android:id="@+id/confirm_candidate_kick"
                    style="@style/Tb.Kick"
                    android:text="@string/confirm_job_kick" />

                <TextView
                    android:id="@+id/job_name"
                    style="@style/Tb.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/confirm_job_name_sample" />

                <TextView
                    android:id="@+id/job_detail"
                    style="@style/Tb.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_job_detail_sample" />

                <TextView
                    android:id="@+id/confirm_candidate_badge"
                    style="@style/Tb.Chip.Accent"
                    android:layout_marginTop="22dp"
                    android:text="@string/confirm_candidate" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tb.Card"
                android:layout_marginTop="@dimen/tb_gap">

                <TextView
                    style="@style/Tb.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_other_title" />

                <TextView
                    android:id="@+id/btn_pick_job"
                    style="@style/Tb.Button.Small"
                    android:layout_marginTop="@dimen/tb_gap"
                    android:text="@string/action_pick_job" />

                <TextView
                    android:id="@+id/btn_enter_place"
                    style="@style/Tb.Button.Small.Ghost"
                    android:layout_marginTop="@dimen/tb_gap_sm"
                    android:text="@string/action_enter_place" />

                <TextView
                    android:id="@+id/btn_edit_time"
                    style="@style/Tb.Button.Small.Ghost"
                    android:layout_marginTop="@dimen/tb_gap_sm"
                    android:text="@string/action_edit_time" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/tb_gutter"
        android:paddingEnd="@dimen/tb_gutter"
        android:paddingTop="@dimen/tb_gap"
        android:paddingBottom="@dimen/tb_card_pad_v">

        <TextView
            android:id="@+id/btn_confirm_and_memo"
            style="@style/Tb.Button.Primary"
            android:text="@string/action_confirm_and_memo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/tb_gap_sm">

            <TextView
                android:id="@+id/btn_not_work"
                style="@style/Tb.Button.Small.Ghost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/tb_gap_sm"
                android:text="@string/action_not_work" />

            <TextView
                android:id="@+id/btn_later"
                style="@style/Tb.Button.Small.Ghost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/action_later" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
