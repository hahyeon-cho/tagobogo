<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tb_bar_h"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/tb_gutter"
    android:paddingEnd="@dimen/tb_gutter"
    android:background="@color/tb_bg">

    <TextView
        android:id="@+id/topbar_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="@dimen/tb_text_logo"
        android:textStyle="bold"
        android:textColor="@color/tb_ink" />

    <TextView
        android:id="@+id/topbar_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/role_tech"
        android:textSize="@dimen/tb_text_label"
        android:textColor="@color/tb_muted" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/topbar_dot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/topbar_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/tb_text_status"
        android:textColor="@color/tb_muted"
        android:visibility="gone" />
</LinearLayout>
